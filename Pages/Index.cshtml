@page
@model IndexModel
@{
    ViewData["Title"] = "Text File Comparison";
}

<div class="container-fluid">
    <h1 class="text-center mb-4">Text File Comparison Tool</h1>
    
    <form method="post">
        <div class="row mb-3">
            <div class="col-md-6">
                <label for="newText" class="form-label"><strong>New File (Left)</strong></label>
                <textarea asp-for="NewText" class="form-control" id="newText" rows="20" placeholder="Paste your new file content here..."></textarea>
            </div>
            <div class="col-md-6">
                <label for="oldText" class="form-label"><strong>Old File (Right)</strong></label>
                <textarea asp-for="OldText" class="form-control" id="oldText" rows="20" placeholder="Paste your old file content here..."></textarea>
            </div>
        </div>
        
        <div class="text-center mb-3">
            <button type="button" class="btn btn-primary" onclick="compareTexts()">Compare Files</button>
            <button type="button" class="btn btn-secondary" onclick="clearAll()">Clear All</button>
        </div>
    </form>
    
    <div id="comparisonResult" class="row" style="display: none;">
        <div class="col-12">
            <h3>Comparison Result</h3>
            <div class="row">
                <div class="col-md-6">
                    <h5>New File (Left) <span class="badge bg-success">Added</span></h5>
                    <div id="newFileComparison" class="comparison-panel"></div>
                </div>
                <div class="col-md-6">
                    <h5>Old File (Right) <span class="badge bg-danger">Removed</span></h5>
                    <div id="oldFileComparison" class="comparison-panel"></div>
                </div>
            </div>
        </div>
    </div>
</div>
